{
  "title": "Google Maps scraper input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchQuery": {
      "title": "Search query",
      "type": "string",
      "description": "Business type or search term",
      "editor": "textfield"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "City, state, or area to search in",
      "editor": "textfield"
    },
    "maxResults": {
      "title": "Max results",
      "type": "integer",
      "description": "Maximum number of businesses to return",
      "default": 20,
      "minimum": 1,
      "maximum": 200,
      "editor": "number"
    }
  },
  "required": ["searchQuery", "location"]
}
