# ChronosOS web service — environment configuration
# Copy to .env and fill in real values. This file contains no real secrets.

# PostgreSQL connection string
DATABASE_URL=postgresql://chronos:chronos_secret@localhost:5432/chronos_db

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Public API URL exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI backend URL (server-side)
FASTAPI_URL=http://localhost:8000

# WebSocket server port
WS_PORT=3001
